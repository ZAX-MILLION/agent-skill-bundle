[Unit]
Description=Agent Skill Bundle upstream review-branch preparation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agent-skill-bundle
Group=agent-skill-bundle
WorkingDirectory=/srv/agent-skill-bundle
EnvironmentFile=-/etc/agent-skill-bundle/update.env
ExecStart=/usr/bin/git switch main
ExecStart=/usr/bin/git pull --ff-only origin main
ExecStart=/usr/bin/python3 scripts/prepare_updates.py --apply --push
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/agent-skill-bundle
UMask=0077
